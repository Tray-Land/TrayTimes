<?xml version="1.0" encoding="utf-8"?>
<!--  A route's service alerts as a warning sign (red when one suspends service) that opens their details  -->
<UserControl
    x:Class="TrayTimes.Controls.AlertsButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TrayTimes.ViewModels"
    Visibility="{x:Bind ViewModel.IsVisible, Mode=OneWay}">
    <Button
        x:Name="SignButton"
        AutomationProperties.Name="{x:Bind ViewModel.SignName, Mode=OneWay}"
        Click="SignButton_Click"
        Style="{StaticResource ToolbarButtonStyle}"
        ToolTipService.ToolTip="{x:Bind ViewModel.SignName, Mode=OneWay}">
        <Grid AutomationProperties.AccessibilityView="Raw">
            <FontIcon
                Visibility="{x:Bind ViewModel.ShowsCaution, Mode=OneWay}"
                FontSize="16"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Glyph="&#xE7BA;" />
            <FontIcon
                FontSize="16"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Glyph="&#xE7BA;"
                Visibility="{x:Bind ViewModel.IsSevere, Mode=OneWay}" />
        </Grid>
        <FlyoutBase.AttachedFlyout>
            <Flyout x:Name="DetailsFlyout" Opening="DetailsFlyout_Opening">
                <StackPanel MaxWidth="300" Spacing="12">
                    <TextBlock
                        Text="{x:Bind ViewModel.Heading, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="16" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AlertEntry" x:DefaultBindMode="OneTime">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Title}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Summary}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind ShowsSummary}" />
                                    <!--  Selectable, so stop numbers and web addresses in it can be copied  -->
                                    <TextBlock
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind Body}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind ShowsBody}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Flyout>
        </FlyoutBase.AttachedFlyout>
    </Button>
</UserControl>
