<?xml version="1.0" encoding="utf-8"?>
<!--  A route's service alerts as a warning sign (red when one suspends service) that opens their details  -->
<UserControl
    x:Class="TrayTimes.Controls.AlertsButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrayTimes.Controls"
    Visibility="Collapsed">
    <Button
        x:Name="SignButton"
        Click="SignButton_Click"
        Style="{StaticResource ToolbarButtonStyle}">
        <Grid AutomationProperties.AccessibilityView="Raw">
            <FontIcon
                x:Name="CautionIcon"
                FontSize="16"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Glyph="&#xE7BA;" />
            <FontIcon
                x:Name="CriticalIcon"
                FontSize="16"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Glyph="&#xE7BA;"
                Visibility="Collapsed" />
        </Grid>
        <FlyoutBase.AttachedFlyout>
            <Flyout x:Name="DetailsFlyout" Opening="DetailsFlyout_Opening">
                <StackPanel MaxWidth="300" Spacing="12">
                    <TextBlock
                        x:Name="HeadingText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <ItemsControl x:Name="AlertsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="16" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="controls:AlertEntry" x:DefaultBindMode="OneTime">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Title}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Summary}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind SummaryVisibility}" />
                                    <!--  Selectable, so stop numbers and web addresses in it can be copied  -->
                                    <TextBlock
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind Body}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind BodyVisibility}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Flyout>
        </FlyoutBase.AttachedFlyout>
    </Button>
</UserControl>
