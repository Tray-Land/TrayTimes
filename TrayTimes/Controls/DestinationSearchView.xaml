<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrayTimes.Controls.DestinationSearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TrayTimes.ViewModels">
    <Grid Padding="8" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Uid="DestinationSearchBack"
                AutomationProperties.AutomationId="DestinationSearchBack"
                Command="{x:Bind ViewModel.BackCommand}"
                Style="{StaticResource ToolbarButtonStyle}">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="16"
                    Glyph="&#xE72B;" />
            </Button>
            <AutoSuggestBox
                x:Name="QueryBox"
                x:Uid="DestinationSearchQuery"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="DestinationSearchQuery"
                QueryIcon="Find"
                QuerySubmitted="QueryBox_QuerySubmitted"
                Text="{x:Bind ViewModel.QueryText, Mode=TwoWay}" />
        </Grid>
        <TextBlock
            Grid.Row="1"
            AutomationProperties.AutomationId="DestinationSearchStatus"
            AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.Status, Mode=OneWay}"
            TextWrapping="Wrap" />
        <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.ShowsRecent, Mode=OneWay}">
            <TextBlock
                x:Uid="DestinationSearchRecent"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <HyperlinkButton
                x:Uid="DestinationSearchClearRecent"
                HorizontalAlignment="Right"
                AutomationProperties.AutomationId="DestinationSearchClearRecent"
                Command="{x:Bind ViewModel.ClearRecentCommand}" />
        </Grid>
        <ListView
            x:Uid="DestinationSearchResults"
            Grid.Row="3"
            Padding="0,0,0,28"
            AutomationProperties.AutomationId="DestinationSearchResults"
            HorizontalContentAlignment="Stretch"
            IsItemClickEnabled="True"
            ItemClick="ResultsList_ItemClick"
            ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:DestinationSearchItem" x:DefaultBindMode="OneTime">
                    <StackPanel Padding="4" Spacing="2" AutomationProperties.Name="{x:Bind AutomationName}">
                        <TextBlock
                            MaxLines="2"
                            Text="{x:Bind Label}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            Text="{x:Bind Detail}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
