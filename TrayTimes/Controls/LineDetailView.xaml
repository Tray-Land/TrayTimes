<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrayTimes.Controls.LineDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:TrayTimes.Views"
    xmlns:vm="using:TrayTimes.ViewModels">

    <UserControl.Resources>
        <!--  A small route badge for a route that crosses the stop. It is only a picture: the whole row is the button  -->
        <DataTemplate
            x:Key="TransferChipTemplate"
            x:DataType="vm:TransferChip"
            x:DefaultBindMode="OneTime">
            <Border
                MinWidth="24"
                Height="18"
                Padding="4,0"
                Background="{x:Bind views:XamlFunctions.Solid(Background)}"
                CornerRadius="3">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{x:Bind views:XamlFunctions.Solid(Foreground)}"
                    Text="{x:Bind Label}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Back · the line's badge, name and direction · loading  -->
        <Grid Margin="6,2,10,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BackButton"
                x:Uid="TripBackButton"
                AutomationProperties.AutomationId="LineBackButton"
                Command="{x:Bind ViewModel.BackCommand}"
                Style="{StaticResource ToolbarButtonStyle}">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="16"
                    Glyph="&#xE72B;" />
            </Button>
            <Border
                Grid.Column="1"
                MinWidth="44"
                Height="28"
                Padding="6,0"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                Background="{x:Bind views:XamlFunctions.Solid(ViewModel.RouteColor), Mode=OneWay}"
                CornerRadius="4">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{x:Bind views:XamlFunctions.Solid(ViewModel.RouteTextColor), Mode=OneWay}"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.RouteLabel, Mode=OneWay}" />
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock
                    AutomationProperties.AutomationId="LineHeading"
                    MaxLines="2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.Heading, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <TextBlock
                    AutomationProperties.AutomationId="LineDirectionName"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Subheading, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <ProgressRing
                x:Uid="LineLoadingRing"
                Grid.Column="3"
                Width="16"
                Height="16"
                MinWidth="16"
                MinHeight="16"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                IsIndeterminate="True" />
        </Grid>

        <!--  The segmented control: one tab per direction of travel  -->
        <ScrollViewer
            Grid.Row="1"
            Margin="6,0"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <SelectorBar
                x:Name="DirectionsBar"
                x:Uid="LineDirections"
                AutomationProperties.AutomationId="LineDirections"
                SelectionChanged="DirectionsBar_SelectionChanged" />
        </ScrollViewer>

        <TextBlock
            Grid.Row="2"
            Margin="14,8"
            AutomationProperties.AutomationId="LineStatus"
            AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.Status, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}" />

        <ListView
            x:Uid="LineStops"
            Grid.Row="3"
            Padding="6,0,6,36"
            AutomationProperties.AutomationId="LineStops"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind ViewModel.Stops, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LineStopItem" x:DefaultBindMode="OneTime">
                    <Button
                        Padding="0"
                        AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                        Click="StopButton_Click"
                        Style="{StaticResource RowButtonStyle}">
                        <Grid MinHeight="46">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  The line running down through its stops, with a bus where one is nearest  -->
                            <Grid AutomationProperties.AccessibilityView="Raw">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Rectangle
                                    Width="4"
                                    HorizontalAlignment="Center"
                                    Fill="{x:Bind views:XamlFunctions.Solid(LineColor)}"
                                    Visibility="{x:Bind ShowsLineAbove}" />
                                <Rectangle
                                    Grid.Row="1"
                                    Width="4"
                                    HorizontalAlignment="Center"
                                    Fill="{x:Bind views:XamlFunctions.Solid(LineColor)}"
                                    Visibility="{x:Bind ShowsLineBelow}" />
                                <Ellipse
                                    Grid.RowSpan="2"
                                    Width="12"
                                    Height="12"
                                    Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                    Stroke="{x:Bind views:XamlFunctions.Solid(LineColor)}"
                                    StrokeThickness="3"
                                    Visibility="{x:Bind ShowsDot, Mode=OneWay}" />
                                <Grid Grid.RowSpan="2" Visibility="{x:Bind HasBus, Mode=OneWay}">
                                    <Ellipse
                                        Width="26"
                                        Height="26"
                                        Fill="{x:Bind views:XamlFunctions.Solid(LineColor)}"
                                        Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                        StrokeThickness="2" />
                                    <FontIcon
                                        FontSize="13"
                                        Foreground="{x:Bind views:XamlFunctions.Solid(LineTextColor)}"
                                        Glyph="&#xE806;" />
                                    <Border
                                        MinWidth="14"
                                        Height="14"
                                        Margin="0,0,2,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource SystemFillColorCriticalBrush}"
                                        CornerRadius="7"
                                        Visibility="{x:Bind ShowsBusCount, Mode=OneWay}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{x:Bind BusText, Mode=OneWay}" />
                                    </Border>
                                </Grid>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="4,8,8,8" VerticalAlignment="Center" Spacing="4">
                                <TextBlock
                                    MaxLines="2"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <ItemsControl
                                    AutomationProperties.AccessibilityView="Raw"
                                    IsHitTestVisible="False"
                                    ItemTemplate="{StaticResource TransferChipTemplate}"
                                    ItemsSource="{x:Bind Transfers, Mode=OneWay}"
                                    Visibility="{x:Bind HasTransfers, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>

                            <FontIcon
                                Grid.Column="2"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="14"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE735;"
                                Visibility="{x:Bind IsFavorite, Mode=OneWay}" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
