<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrayTimes.Controls.PlacePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="4">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="AddressBox"
                AutomationProperties.Name="{x:Bind AddressAutomationName, Mode=OneWay}"
                Header="{x:Bind Header, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.IsSearchAvailable, Mode=OneTime}"
                ItemsSource="{x:Bind ViewModel.Suggestions, Mode=OneWay}"
                PlaceholderText="{x:Bind SearchPlaceholder, Mode=OneTime}"
                QueryIcon="Find"
                QuerySubmitted="AddressBox_QuerySubmitted"
                SuggestionChosen="AddressBox_SuggestionChosen"
                TextChanged="AddressBox_TextChanged" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="Use my current location"
                Command="{x:Bind ViewModel.LocateCommand}"
                ToolTipService.ToolTip="Use my current location">
                <FontIcon FontSize="16" Glyph="&#xE81D;" />
            </Button>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                TextWrapping="Wrap" />
            <HyperlinkButton
                Padding="4,0"
                Command="{x:Bind ViewModel.ClearCommand}"
                Content="Clear"
                FontSize="12"
                Visibility="{x:Bind ViewModel.CanClear, Mode=OneWay}" />
        </StackPanel>
    </StackPanel>
</UserControl>
