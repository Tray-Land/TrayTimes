<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrayTimes.Controls.SuggestionCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrayTimes.Controls"
    xmlns:views="using:TrayTimes.Views">

    <UserControl.Resources>
        <!--  One ride's route badge, after an arrow from the ride before it  -->
        <DataTemplate
            x:Key="RouteChipTemplate"
            x:DataType="controls:RouteChipItem"
            x:DefaultBindMode="OneTime">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <FontIcon
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="10"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE72A;"
                    Visibility="{x:Bind ShowsArrow}" />
                <Border
                    MinWidth="28"
                    Height="20"
                    Padding="5,0"
                    Background="{x:Bind views:XamlFunctions.Solid(Color)}"
                    CornerRadius="3">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind views:XamlFunctions.Solid(TextColor)}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Label}" />
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!--  Bound to the view model, which raises a change for everything when the card shows a new item  -->
    <Grid
        Padding="6,8,8,0"
        
        ColumnSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  The trip: where to, when to leave, its rides, and when it gets there  -->
        <Button
            x:Name="TripButton"
            AutomationProperties.AutomationId="SuggestionCard"
            AutomationProperties.Name="{x:Bind ViewModel.AutomationName, Mode=OneWay}"
            Command="{x:Bind ViewModel.InvokeTripCommand}"
            Style="{StaticResource RowButtonStyle}"
            ToolTipService.ToolTip="{x:Bind ViewModel.TripToolTip, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ShowsTrip, Mode=OneWay}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="20"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="{x:Bind ViewModel.Glyph, Mode=OneWay}" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ItemsControl
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            ItemTemplate="{StaticResource RouteChipTemplate}"
                            ItemsSource="{x:Bind ViewModel.Routes, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.Detail, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.Note, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.ShowsNote, Mode=OneWay}" />
                </StackPanel>
                <FontIcon
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE76C;" />
            </Grid>
        </Button>

        <!--  In the trip's place: setting up, already there, planning, or no trip  -->
        <Grid
            Padding="8,6"
            ColumnSpacing="12"
            Visibility="{x:Bind ViewModel.ShowsNotice, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="20"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="{x:Bind ViewModel.Glyph, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.ShowsGlyph, Mode=OneWay}" />
            <ProgressRing
                x:Uid="SuggestionPlanningRing"
                Width="20"
                Height="20"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Detail, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.ShowsDetail, Mode=OneWay}" />
            </StackPanel>
            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="SuggestionActionButton"
                Command="{x:Bind ViewModel.RunActionCommand}"
                Content="{x:Bind ViewModel.ActionText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.ShowsAction, Mode=OneWay}" />
        </Grid>

        <!--  Beside the card, not in it, so there's no button inside a button  -->
        <DropDownButton
            x:Name="DestinationButton"
            x:Uid="DestinationButton"
            Grid.Column="1"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="DestinationButton"
            Visibility="{x:Bind ViewModel.ShowsDestination, Mode=OneWay}">
            <DropDownButton.Flyout>
                <MenuFlyout
                    x:Name="DestinationMenu"
                    Opening="DestinationMenu_Opening"
                    Placement="BottomEdgeAlignedRight" />
            </DropDownButton.Flyout>
        </DropDownButton>
        <Button
            x:Name="SaveDestinationButton"
            x:Uid="SaveDestinationButton"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="8,4,0,0"
            AutomationProperties.AutomationId="SaveDestinationButton"
            HorizontalAlignment="Left"
            Command="{x:Bind ViewModel.SaveDestinationCommand}"
            IsEnabled="{x:Bind ViewModel.IsSaveDestinationEnabled, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.CanSaveDestination, Mode=OneWay}" />
    </Grid>
</UserControl>
