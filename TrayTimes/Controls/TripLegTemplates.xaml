<?xml version="1.0" encoding="utf-8"?>
<!--  A trip's walk and ride legs, shared by the trip view and the progress view. In the progress view each leg shows its state:  -->
<!--  a check (done, and dimmed), a filled dot (current), or a ring (upcoming); the trip view shows none.  -->
<ResourceDictionary
    x:Class="TrayTimes.Controls.TripLegTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrayTimes.Controls">

    <DataTemplate
        x:Key="WalkLegTemplate"
        x:DataType="controls:TripWalkItem"
        x:DefaultBindMode="OneTime">
        <Grid Padding="8,8" Opacity="{x:Bind RowOpacity}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
                Width="14"
                Margin="0,4,10,0"
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw"
                Visibility="{x:Bind StateVisibility}">
                <FontIcon
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE73E;"
                    Visibility="{x:Bind DoneVisibility}" />
                <FontIcon
                    FontSize="12"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xEA3B;"
                    Visibility="{x:Bind CurrentVisibility}" />
                <FontIcon
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xEA3A;"
                    Visibility="{x:Bind UpcomingVisibility}" />
            </Grid>
            <FontIcon
                Grid.Column="1"
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="20"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE805;" />
            <StackPanel
                Grid.Column="2"
                Margin="12,0,0,0"
                Spacing="3">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Title}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Detail}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Wait}"
                    Visibility="{x:Bind WaitVisibility}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate
        x:Key="RideLegTemplate"
        x:DataType="controls:TripRideItem"
        x:DefaultBindMode="OneTime">
        <Grid Padding="8,8" Opacity="{x:Bind RowOpacity}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
                Width="14"
                Margin="0,8,10,0"
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw"
                Visibility="{x:Bind StateVisibility}">
                <FontIcon
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE73E;"
                    Visibility="{x:Bind DoneVisibility}" />
                <FontIcon
                    FontSize="12"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xEA3B;"
                    Visibility="{x:Bind CurrentVisibility}" />
                <FontIcon
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xEA3A;"
                    Visibility="{x:Bind UpcomingVisibility}" />
            </Grid>
            <Border
                Grid.Column="1"
                Height="28"
                Padding="4,0"
                VerticalAlignment="Top"
                Background="{x:Bind RouteBackground}"
                CornerRadius="4">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{x:Bind RouteForeground}"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind RouteLabel}" />
            </Border>
            <StackPanel
                Grid.Column="2"
                Margin="12,0,0,0"
                Spacing="3">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Destination}"
                    TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind Board}" TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Detail}"
                    TextWrapping="Wrap" />
                <ScrollViewer
                    Margin="0,3,0,0"
                    AutomationProperties.Name="{x:Bind TimesName}"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled"
                    Visibility="{x:Bind TimesVisibility}">
                    <ItemsControl
                        Margin="0,0,0,6"
                        ItemTemplate="{x:Bind TimeTemplate}"
                        ItemsSource="{x:Bind Times}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Alight}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <controls:TripLegTemplateSelector
        x:Key="LegTemplates"
        RideTemplate="{StaticResource RideLegTemplate}"
        WalkTemplate="{StaticResource WalkLegTemplate}" />
</ResourceDictionary>
