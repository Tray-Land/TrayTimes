<?xml version="1.0" encoding="utf-8"?>
<!--  A trip's walk and ride legs, shared by the trip view and the progress view. In the progress view each leg shows its state:  -->
<!--  a check (done, and dimmed), a filled dot (current), or a ring (upcoming); the trip view shows none.  -->
<!--  A line joins each marker to the next: solid once the rider has passed it, dashed while it is still ahead.  -->
<!--  Rows have no vertical padding, so the lines meet at the row edges; the content is inset and dimmed on its own,  -->
<!--  which leaves the lines undimmed.  -->
<ResourceDictionary
    x:Class="TrayTimes.Controls.TripLegTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrayTimes.Controls"
    xmlns:views="using:TrayTimes.Views">

    <!--  Fills the marker's cell above or below the marker; each leg's dashes say whether the line is solid or dashed  -->
    <Style x:Key="TripLegLinkStyle" TargetType="Line">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Stretch" Value="Fill" />
        <Setter Property="Stroke" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Y2" Value="1" />
    </Style>

    <DataTemplate
        x:Key="WalkLegTemplate"
        x:DataType="controls:TripWalkItem"
        x:DefaultBindMode="OneTime">
        <Grid Padding="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
                Width="14"
                Margin="0,0,10,0"
                AutomationProperties.AccessibilityView="Raw"
                Visibility="{x:Bind ShowsState}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Line
                    Margin="0,0,0,3"
                    StrokeDashArray="{x:Bind views:XamlFunctions.LinkDashes(PreviousLinkTraveled)}"
                    Style="{StaticResource TripLegLinkStyle}"
                    Visibility="{x:Bind ShowsPreviousLink}" />
                <Grid Grid.Row="1" Opacity="{x:Bind RowOpacity}">
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE73E;"
                        Visibility="{x:Bind ShowsDone}" />
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xEA3B;"
                        Visibility="{x:Bind ShowsCurrent}" />
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xEA3A;"
                        Visibility="{x:Bind ShowsUpcoming}" />
                </Grid>
                <Line
                    Grid.Row="2"
                    Margin="0,3,0,0"
                    StrokeDashArray="{x:Bind views:XamlFunctions.LinkDashes(NextLinkTraveled)}"
                    Style="{StaticResource TripLegLinkStyle}"
                    Visibility="{x:Bind ShowsNextLink}" />
            </Grid>
            <FontIcon
                Grid.Column="1"
                Margin="0,8,0,0"
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="20"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE805;"
                Opacity="{x:Bind RowOpacity}" />
            <StackPanel
                Grid.Column="2"
                Margin="12,8,0,8"
                Opacity="{x:Bind RowOpacity}"
                Spacing="3">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Title}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Detail}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Wait}"
                    Visibility="{x:Bind ShowsWait}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate
        x:Key="RideLegTemplate"
        x:DataType="controls:TripRideItem"
        x:DefaultBindMode="OneTime">
        <Grid Padding="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
                Width="14"
                Margin="0,0,10,0"
                AutomationProperties.AccessibilityView="Raw"
                Visibility="{x:Bind ShowsState}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Line
                    Margin="0,0,0,3"
                    StrokeDashArray="{x:Bind views:XamlFunctions.LinkDashes(PreviousLinkTraveled)}"
                    Style="{StaticResource TripLegLinkStyle}"
                    Visibility="{x:Bind ShowsPreviousLink}" />
                <Grid Grid.Row="1" Opacity="{x:Bind RowOpacity}">
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE73E;"
                        Visibility="{x:Bind ShowsDone}" />
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xEA3B;"
                        Visibility="{x:Bind ShowsCurrent}" />
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xEA3A;"
                        Visibility="{x:Bind ShowsUpcoming}" />
                </Grid>
                <Line
                    Grid.Row="2"
                    Margin="0,3,0,0"
                    StrokeDashArray="{x:Bind views:XamlFunctions.LinkDashes(NextLinkTraveled)}"
                    Style="{StaticResource TripLegLinkStyle}"
                    Visibility="{x:Bind ShowsNextLink}" />
            </Grid>
            <StackPanel
                Grid.Column="1"
                Margin="0,8,0,0"
                VerticalAlignment="Top"
                Opacity="{x:Bind RowOpacity}"
                Spacing="6">
                <!--  The badge opens the route's line detail  -->
                <Button
                    Height="28"
                    Padding="4,0"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="TripRouteBadgeButton"
                    AutomationProperties.Name="{x:Bind LineName}"
                    Background="{x:Bind views:XamlFunctions.Solid(RouteColor)}"
                    Click="RouteBadge_Click"
                    Style="{StaticResource RouteBadgeButtonStyle}">
                    <!--  A name too long even in short ("UP-NW") shrinks to fit rather than being cut off  -->
                    <Viewbox
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        StretchDirection="DownOnly">
                        <TextBlock
                            AutomationProperties.AccessibilityView="Raw"
                            Foreground="{x:Bind views:XamlFunctions.Solid(RouteTextColor)}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind RouteBadge}" />
                    </Viewbox>
                </Button>
                <!--  A warning sign that opens the route's service alerts, when it has any  -->
                <controls:AlertsButton
                    HorizontalAlignment="Center"
                    Alerts="{x:Bind Alerts}"
                    Route="{x:Bind RouteLabel}" />
            </StackPanel>
            <StackPanel
                Grid.Column="2"
                Margin="12,8,0,8"
                Opacity="{x:Bind RowOpacity}"
                Spacing="3">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Destination}"
                    TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind Board}" TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Detail}"
                    TextWrapping="Wrap" />
                <ScrollViewer
                    Margin="0,3,0,0"
                    AutomationProperties.Name="{x:Bind TimesName}"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled"
                    Visibility="{x:Bind ShowsTimes}">
                    <ItemsControl
                        Margin="0,0,0,6"
                        ItemTemplate="{x:Bind TimeTemplate}"
                        ItemsSource="{x:Bind Times}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Alight}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <controls:TripLegTemplateSelector
        x:Key="LegTemplates"
        RideTemplate="{StaticResource RideLegTemplate}"
        WalkTemplate="{StaticResource WalkLegTemplate}" />
</ResourceDictionary>
