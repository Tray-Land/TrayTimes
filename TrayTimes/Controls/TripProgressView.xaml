<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrayTimes.Controls.TripProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrayTimes.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:TripLegTemplates />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  The trip view's header, with End trip where Go was: the trip's main action stays in the same place  -->
        <controls:TripHeaderPanel Margin="6,2,10,4">
            <Button
                x:Name="BackButton"
                x:Uid="TripProgressBack"
                AutomationProperties.AutomationId="TripProgressBackButton"
                Click="BackButton_Click"
                Style="{StaticResource ToolbarButtonStyle}">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="16"
                    Glyph="&#xE72B;" />
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    x:Name="HeadingText"
                    AutomationProperties.AutomationId="TripProgressHeading"
                    MaxLines="2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="ArrivalText"
                    AutomationProperties.AutomationId="TripProgressArrival"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Button
                x:Name="EndTripButton"
                x:Uid="EndTripButton"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="EndTripButton"
                Click="EndTripButton_Click" />
        </controls:TripHeaderPanel>

        <!--  The current step, large; the name of the status text is the whole card, read when the step changes  -->
        <Border
            Grid.Row="1"
            Margin="8,2,8,6"
            Padding="14,10,10,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="StatusText"
                    AutomationProperties.AutomationId="TripStatus"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="StatusDetail"
                    AutomationProperties.AccessibilityView="Raw"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <StackPanel
                    x:Name="StatusActions"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="MissedItButton"
                        x:Uid="MissedItButton"
                        AutomationProperties.AutomationId="MissedItButton"
                        MinHeight="28"
                        Padding="8,3"
                        Click="MissedItButton_Click"
                        FontSize="12"
                        Style="{StaticResource SubtleButtonStyle}"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="ResumeButton"
                        x:Uid="ResumeTripButton"
                        AutomationProperties.AutomationId="ResumeTripButton"
                        Click="ResumeButton_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="DiscardButton"
                        x:Uid="DiscardTripButton"
                        AutomationProperties.AutomationId="DiscardTripButton"
                        Click="EndTripButton_Click"
                        Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ListView
            x:Name="StepsList"
            x:Uid="TripSteps"
            Grid.Row="2"
            Padding="6,0,6,6"
            AutomationProperties.AutomationId="TripProgress"
            IsItemClickEnabled="False"
            ItemTemplateSelector="{StaticResource LegTemplates}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.Footer>
                <StackPanel
                    Margin="32,8,8,12"
                    Orientation="Horizontal"
                    Spacing="12">
                    <FontIcon
                        x:Name="DestinationGlyph"
                        Width="40"
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="20"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock
                        x:Name="DestinationText"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="TripProgressDestination"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ListView.Footer>
        </ListView>
    </Grid>
</UserControl>
