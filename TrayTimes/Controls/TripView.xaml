<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrayTimes.Controls.TripView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrayTimes.Controls">

    <UserControl.Resources>
        <DataTemplate
            x:Key="WalkLegTemplate"
            x:DataType="controls:TripWalkItem"
            x:DefaultBindMode="OneTime">
            <Grid Padding="8,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Top"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="20"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE805;" />
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Title}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Detail}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Wait}"
                        Visibility="{x:Bind WaitVisibility}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate
            x:Key="RideLegTemplate"
            x:DataType="controls:TripRideItem"
            x:DefaultBindMode="OneTime">
            <Grid Padding="8,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Height="28"
                    Padding="4,0"
                    VerticalAlignment="Top"
                    Background="{x:Bind RouteBackground}"
                    CornerRadius="4">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{x:Bind RouteForeground}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind RouteLabel}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Destination}"
                        TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Board}" TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Detail}"
                        TextWrapping="Wrap" />
                    <ScrollViewer
                        Margin="0,3,0,0"
                        AutomationProperties.Name="{x:Bind TimesName}"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled"
                        Visibility="{x:Bind TimesVisibility}">
                        <ItemsControl
                            Margin="0,0,0,6"
                            ItemTemplate="{x:Bind TimeTemplate}"
                            ItemsSource="{x:Bind Times}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Alight}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <controls:TripLegTemplateSelector
            x:Key="LegTemplates"
            RideTemplate="{StaticResource RideLegTemplate}"
            WalkTemplate="{StaticResource WalkLegTemplate}" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="6,2,10,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BackButton"
                x:Uid="TripBackButton"
                AutomationProperties.AutomationId="TripBackButton"
                Click="BackButton_Click"
                Style="{StaticResource ToolbarButtonStyle}">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="16"
                    Glyph="&#xE72B;" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    x:Name="HeadingText"
                    AutomationProperties.AutomationId="TripHeading"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="ArrivalText"
                    AutomationProperties.AutomationId="TripArrival"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="TimeAnchor"
            Grid.Row="1"
            Margin="8,4">
            <FlyoutBase.AttachedFlyout>
                <Flyout x:Name="TimeEditorFlyout">
                    <StackPanel Width="280" Spacing="12">
                        <TextBlock
                            x:Name="TimeEditorHeading"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <CalendarDatePicker
                            x:Name="TravelDatePicker"
                            x:Uid="TripTravelDate"
                            AutomationProperties.AutomationId="TripTravelDate"
                            HorizontalAlignment="Stretch" />
                        <TimePicker
                            x:Name="TravelClockPicker"
                            x:Uid="TripTravelClock"
                            AutomationProperties.AutomationId="TripTravelClock"
                            HorizontalAlignment="Stretch"
                            MinuteIncrement="5" />
                        <TextBlock
                            x:Name="TimeValidationText"
                            AutomationProperties.AutomationId="TripTimeValidation"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Uid="TripTimeApply"
                                AutomationProperties.AutomationId="TripTimeApply"
                                Click="TimeApply_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Uid="TripTimeCancel"
                                AutomationProperties.AutomationId="TripTimeCancel"
                                Click="TimeCancel_Click" />
                        </StackPanel>
                    </StackPanel>
                </Flyout>
            </FlyoutBase.AttachedFlyout>
            <DropDownButton
                x:Name="TimeButton"
                AutomationProperties.AutomationId="TripTimeButton"
                HorizontalAlignment="Left">
                <TextBlock
                    x:Name="TimeButtonText"
                    MaxWidth="280"
                    TextTrimming="CharacterEllipsis" />
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            x:Uid="TripLeaveNow"
                            AutomationProperties.AutomationId="TripLeaveNow"
                            Click="LeaveNow_Click" />
                        <MenuFlyoutItem
                            x:Uid="TripLeaveAt"
                            AutomationProperties.AutomationId="TripLeaveAt"
                            Click="LeaveAt_Click" />
                        <MenuFlyoutItem
                            x:Uid="TripArriveBy"
                            AutomationProperties.AutomationId="TripArriveBy"
                            Click="ArriveBy_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <ScrollViewer
            x:Uid="TripOptionsScroller"
            Grid.Row="2"
            Margin="6,0"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <SelectorBar
                x:Name="OptionsBar"
                x:Uid="TripOptions"
                AutomationProperties.AutomationId="TripOptions"
                SelectionChanged="OptionsBar_SelectionChanged" />
        </ScrollViewer>

        <InfoBar
            x:Name="NoticeBar"
            Grid.Row="3"
            Margin="8,4"
            AutomationProperties.AutomationId="TripNotice"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational" />

        <ListView
            x:Name="LegsList"
            x:Uid="TripLegs"
            Grid.Row="4"
            Padding="6,0,6,6"
            AutomationProperties.AutomationId="TripLegs"
            IsItemClickEnabled="False"
            ItemTemplateSelector="{StaticResource LegTemplates}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.Footer>
                <StackPanel
                    x:Name="DestinationFooter"
                    Margin="8,8,8,12"
                    Orientation="Horizontal"
                    Spacing="12">
                    <FontIcon
                        x:Name="DestinationGlyph"
                        Width="40"
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="20"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock
                        x:Name="DestinationText"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="TripDestination"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ListView.Footer>
        </ListView>
    </Grid>
</UserControl>
