<?xml version="1.0" encoding="utf-8"?>
<ex:WindowEx
    x:Class="TrayTimes.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrayTimes.Controls"
    xmlns:ex="using:WinUIEx"
    xmlns:local="using:TrayTimes.Views"
    xmlns:map="using:WinUIEx.Maps"
    xmlns:models="using:TrayTimes.Models"
    Title="Tray Times Settings"
    IsMaximizable="False"
    IsMinimizable="False">

    <ex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </ex:WindowEx.SystemBackdrop>

    <ScrollViewer x:Name="Root">
        <StackPanel Padding="28,24" Spacing="8">
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Settings" />

            <InfoBar
                x:Name="KeyBar"
                Title="No MCTS API key"
                IsClosable="False"
                IsOpen="False"
                Message="Copy OAuth.resw.sample to OAuth.resw, paste your BusTime key into MctsApiKey, and rebuild."
                Severity="Error" />

            <!--  Favorite places  -->
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Favorite places" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="The flyout's Commute tab uses these to guess where you're headed next: home when you're out, and work (or school) when you're home."
                TextWrapping="Wrap" />
            <controls:PlacePicker x:Name="HomePicker" Header="Home" PlaceChosen="FixedPlacePicker_PlaceChosen" />
            <controls:PlacePicker x:Name="WorkPicker" Header="Work" PlaceChosen="FixedPlacePicker_PlaceChosen" />
            <controls:PlacePicker x:Name="SchoolPicker" Header="School" PlaceChosen="FixedPlacePicker_PlaceChosen" />
            <StackPanel x:Name="CustomPlacesPanel" Spacing="8" />
            <Button
                x:Name="AddPlaceButton"
                AutomationProperties.Name="Add a custom place"
                Click="AddPlaceButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="Add a place" />
                </StackPanel>
            </Button>

            <!--  Saved stops  -->
            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Favorite stops" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Drag to reorder. The first three appear in the tray icon's tooltip."
                TextWrapping="Wrap" />
            <ListView
                x:Name="SavedStopsList"
                AllowDrop="True"
                AutomationProperties.Name="Favorite stops"
                CanDragItems="True"
                CanReorderItems="True"
                DragItemsCompleted="SavedStopsList_DragItemsCompleted"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SavedStop" x:DefaultBindMode="OneTime">
                        <Grid Padding="0,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind StopName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Description}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                AutomationProperties.Name="Remove stop"
                                Click="RemoveStopButton_Click"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTipService.ToolTip="Remove">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                x:Name="NoStopsText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No stops yet. Add one below." />

            <!--  Add a stop  -->
            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Add a stop" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Choose a route and direction, then pick a stop from the list or tap it on the map."
                TextWrapping="Wrap" />
            <ComboBox
                x:Name="RouteBox"
                MinWidth="320"
                Header="Route"
                IsEnabled="False"
                PlaceholderText="Loading routes…"
                SelectionChanged="RouteBox_SelectionChanged" />
            <ComboBox
                x:Name="DirectionBox"
                MinWidth="320"
                Header="Direction"
                IsEnabled="False"
                SelectionChanged="DirectionBox_SelectionChanged" />
            <ComboBox
                x:Name="StopBox"
                MinWidth="320"
                Header="Stop"
                IsEnabled="False"
                SelectionChanged="StopBox_SelectionChanged" />
            <Grid
                Height="280"
                Margin="0,4,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <map:MapControl
                    x:Name="PickerMap"
                    AutomationProperties.Name="Map of the route's stops. Tap a stop to choose it."
                    MapStyle="Road" />
                <ProgressRing
                    x:Name="PickerLoadingRing"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Loading stops"
                    IsActive="False" />
            </Grid>
            <CheckBox x:Name="AllRoutesCheck" Content="Show every route that serves this stop" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="AddStopButton"
                    Click="AddStopButton_Click"
                    Content="Add stop"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
                <TextBlock
                    x:Name="AddStatusText"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  Tracking  -->
            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Bus alerts" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Ring the bell next to a bus to track it. Tray Times keeps its minutes away in the tray icon and notifies you when it's time to leave."
                TextWrapping="Wrap" />
            <NumberBox
                x:Name="HeadOutBox"
                MinWidth="200"
                HorizontalAlignment="Left"
                Header="Notify me this many minutes before the bus arrives"
                SmallChange="1"
                SpinButtonPlacementMode="Inline"
                ValueChanged="HeadOutBox_ValueChanged" />
            <ToggleSwitch
                x:Name="KeepAwakeToggle"
                Header="Keep the PC awake while tracking a bus"
                Toggled="KeepAwakeToggle_Toggled" />

            <!--  API usage  -->
            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Transit API usage" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="How many requests Tray Times has sent to the MCTS BusTime API, by endpoint. Counts cover the last 14 days."
                TextWrapping="Wrap" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                    <Style BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Style>
                </Grid.Resources>
                <TextBlock Text="Endpoint" />
                <TextBlock
                    Grid.Column="1"
                    HorizontalTextAlignment="End"
                    Text="Today" />
                <TextBlock
                    Grid.Column="2"
                    HorizontalTextAlignment="End"
                    Text="7 days" />
                <TextBlock
                    Grid.Column="3"
                    HorizontalTextAlignment="End"
                    Text="14 days" />
            </Grid>
            <ItemsControl
                x:Name="ApiUsageList"
                AutomationProperties.Name="Transit API requests by endpoint"
                IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ApiUsageRow" x:DefaultBindMode="OneTime">
                        <Grid Padding="0,4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalTextAlignment="End"
                                Text="{x:Bind Today}" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalTextAlignment="End"
                                Text="{x:Bind Last7Days}" />
                            <TextBlock
                                Grid.Column="3"
                                HorizontalTextAlignment="End"
                                Text="{x:Bind Last14Days}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button
                x:Name="ResetApiUsageButton"
                AutomationProperties.Name="Reset API usage counts"
                Click="ResetApiUsageButton_Click"
                Content="Reset counts" />

            <!--  General  -->
            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="General" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock
                    x:Name="StopIndexText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="RebuildIndexButton"
                    Click="RebuildIndexButton_Click"
                    Content="Update now" />
            </StackPanel>
            <ToggleSwitch
                x:Name="StartupToggle"
                Header="Start with Windows"
                Toggled="StartupToggle_Toggled" />
            <TextBlock
                x:Name="StartupStatusText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <!--  About  -->
            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="About" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                <Run Text="Arrival times and bus locations: Milwaukee County Transit System real-time BusTime API." />
                <LineBreak />
                <Run Text="Basemap: Azure Maps. Map control: WinUIEx.Maps by Morten Nielsen." />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</ex:WindowEx>
