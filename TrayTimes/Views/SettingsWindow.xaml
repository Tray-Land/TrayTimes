<?xml version="1.0" encoding="utf-8"?>
<ex:WindowEx
    x:Class="TrayTimes.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrayTimes.Controls"
    xmlns:ex="using:WinUIEx"
    xmlns:local="using:TrayTimes.Views"
    xmlns:map="using:WinUIEx.Maps"
    xmlns:models="using:TrayTimes.Models"
    xmlns:transit="using:TrayTimes.Transit"
    xmlns:vm="using:TrayTimes.ViewModels"
    MinHeight="480"
    MinWidth="520"
    IsMaximizable="False"
    IsMinimizable="False">

    <ex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </ex:WindowEx.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <Style
                x:Key="SettingsDescriptionStyle"
                BasedOn="{StaticResource CaptionTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style
                x:Key="SettingsSectionStyle"
                BasedOn="{StaticResource SubtitleTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Margin" Value="0,24,0,4" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
            </Style>
            <Style
                x:Key="SettingsCardTitleStyle"
                BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SettingsCardStyle" TargetType="Grid">
                <Setter Property="Padding" Value="20,16" />
                <Setter Property="ColumnSpacing" Value="16" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="SettingsExpanderStyle" TargetType="Expander">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="SettingsIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Width" Value="20" />
                <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="SettingsTitleBar" x:Uid="SettingsTitleBar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Square44x44Logo.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <ScrollViewer
            x:Name="SettingsScrollViewer"
            Grid.Row="1"
            AutomationProperties.AutomationId="SettingsScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="760"
                Padding="32,16,32,32"
                Spacing="8">
                <TextBlock
                    x:Uid="SettingsHeading"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Uid="SettingsIntroduction" Style="{StaticResource SettingsDescriptionStyle}" />

                <InfoBar
                    x:Uid="SettingsKeyBar"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsKeyMissing, Mode=OneTime}"
                    Severity="Error" />

                <TextBlock x:Uid="SettingsCommuteHeading" Style="{StaticResource SettingsSectionStyle}" />

                <Expander
                    x:Name="PlacesExpander"
                    x:Uid="SettingsPlacesExpander"
                    AutomationProperties.AutomationId="PlacesExpander"
                    Style="{StaticResource SettingsExpanderStyle}">
                    <Expander.Header>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE80F;" Style="{StaticResource SettingsIconStyle}" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Uid="SettingsPlacesTitle" Style="{StaticResource SettingsCardTitleStyle}" />
                                <TextBlock x:Uid="SettingsPlacesDescription" Style="{StaticResource SettingsDescriptionStyle}" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="SettingsPlacesHelp" Style="{StaticResource SettingsDescriptionStyle}" />
                        <controls:PlacePicker
                            x:Uid="SettingsHomePicker"
                            AutomationProperties.AutomationId="HomePicker"
                            Place="{x:Bind ViewModel.HomePlace, Mode=TwoWay}" />
                        <controls:PlacePicker
                            x:Uid="SettingsWorkPicker"
                            AutomationProperties.AutomationId="WorkPicker"
                            Place="{x:Bind ViewModel.WorkPlace, Mode=TwoWay}" />
                        <controls:PlacePicker
                            x:Uid="SettingsSchoolPicker"
                            AutomationProperties.AutomationId="SchoolPicker"
                            Place="{x:Bind ViewModel.SchoolPlace, Mode=TwoWay}" />
                        <ItemsControl
                            x:Name="CustomPlacesList"
                            IsTabStop="False"
                            ItemsSource="{x:Bind ViewModel.CustomPlaces, Mode=OneTime}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CustomPlaceViewModel">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                x:Uid="SettingsCustomPlaceNameBox"
                                                AutomationProperties.AutomationId="{x:Bind NameAutomationId, Mode=OneTime}"
                                                Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button
                                                Grid.Column="1"
                                                VerticalAlignment="Bottom"
                                                AutomationProperties.AutomationId="{x:Bind RemoveAutomationId, Mode=OneTime}"
                                                AutomationProperties.Name="{x:Bind RemoveLabel, Mode=OneWay}"
                                                Command="{x:Bind RemoveCommand}"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                ToolTipService.ToolTip="{x:Bind RemoveLabel, Mode=OneWay}">
                                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                            </Button>
                                        </Grid>
                                        <controls:PlacePicker AddressAutomationName="{x:Bind AddressLabel, Mode=OneWay}" Place="{x:Bind Place, Mode=TwoWay}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button
                            x:Name="AddPlaceButton"
                            x:Uid="SettingsAddPlaceButton"
                            AutomationProperties.AutomationId="AddPlaceButton"
                            HorizontalAlignment="Left"
                            Command="{x:Bind ViewModel.AddCustomPlaceCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontSize="14"
                                    Glyph="&#xE710;" />
                                <TextBlock x:Uid="SettingsAddPlaceLabel" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Expander>

                <Expander
                    x:Uid="SettingsSavedStopsExpander"
                    AutomationProperties.AutomationId="SavedStopsExpander"
                    IsExpanded="{x:Bind ViewModel.IsSavedStopsExpanded, Mode=TwoWay}"
                    Style="{StaticResource SettingsExpanderStyle}">
                    <Expander.Header>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE734;" Style="{StaticResource SettingsIconStyle}" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Uid="SettingsSavedStopsTitle" Style="{StaticResource SettingsCardTitleStyle}" />
                                <TextBlock x:Uid="SettingsSavedStopsDescription" Style="{StaticResource SettingsDescriptionStyle}" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="8">
                        <ListView
                            x:Name="SavedStopsList"
                            x:Uid="SettingsSavedStopsList"
                            AutomationProperties.AutomationId="SavedStopsList"
                            MaxHeight="280"
                            AllowDrop="True"
                            CanDragItems="True"
                            CanReorderItems="True"
                            DragItemsCompleted="SavedStopsList_DragItemsCompleted"
                            ItemsSource="{x:Bind ViewModel.SavedStops, Mode=OneTime}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SavedStopRow" x:DefaultBindMode="OneTime">
                                    <Grid Padding="0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontSize="16"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE700;" />
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="4">
                                            <TextBlock Text="{x:Bind StopName}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="{x:Bind Description}" />
                                            <TextBox
                                                x:Uid="SettingsStopNicknameBox"
                                                KeyDown="StopNicknameBox_KeyDown"
                                                LostFocus="StopNicknameBox_LostFocus"
                                                MaxLength="40"
                                                Text="{x:Bind Nickname, Mode=OneWay}" />
                                        </StackPanel>
                                        <Button
                                            x:Uid="SettingsRemoveStopButton"
                                            Grid.Column="2"
                                            Command="{x:Bind RemoveCommand}"
                                            Style="{StaticResource ToolbarButtonStyle}">
                                            <FontIcon
                                                AutomationProperties.AccessibilityView="Raw"
                                                FontSize="14"
                                                Glyph="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            x:Uid="SettingsNoStopsText"
                            Style="{StaticResource SettingsDescriptionStyle}"
                            Visibility="{x:Bind ViewModel.HasNoSavedStops, Mode=OneWay}" />
                    </StackPanel>
                </Expander>

                <Expander
                    x:Uid="SettingsAddStopExpander"
                    AutomationProperties.AutomationId="AddStopExpander"
                    IsExpanded="{x:Bind ViewModel.IsAddStopExpanded, Mode=TwoWay}"
                    Style="{StaticResource SettingsExpanderStyle}">
                    <Expander.Header>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE710;" Style="{StaticResource SettingsIconStyle}" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Uid="SettingsAddStopTitle" Style="{StaticResource SettingsCardTitleStyle}" />
                                <TextBlock x:Uid="SettingsAddStopDescription" Style="{StaticResource SettingsDescriptionStyle}" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SettingsAddStopHelp" Style="{StaticResource SettingsDescriptionStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="AreaSearchBox"
                                x:Uid="SettingsAreaBox"
                                AutomationProperties.AutomationId="AreaSearchBox"
                                KeyDown="AreaSearchBox_KeyDown"
                                Text="{x:Bind ViewModel.AreaSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                x:Uid="SettingsAreaButton"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="AreaSearchButton"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.FindAreaCommand}" />
                        </Grid>
                        <TextBlock
                            Style="{StaticResource SettingsDescriptionStyle}"
                            Text="{x:Bind ViewModel.AreaStatus, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasAreaStatus, Mode=OneWay}" />
                        <Grid
                            Height="280"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <map:MapControl
                                x:Name="PickerMap"
                                x:Uid="SettingsPickerMap"
                                AutomationProperties.AutomationId="PickerMap"
                                MapStyle="Road" />
                            <ProgressRing
                                x:Uid="SettingsPickerLoadingRing"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsActive="{x:Bind ViewModel.IsPickerLoading, Mode=OneWay}" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Uid="SettingsStopSearchBox"
                                AutomationProperties.AutomationId="StopSearchBox"
                                KeyDown="StopSearchBox_KeyDown"
                                Text="{x:Bind ViewModel.StopSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                x:Uid="SettingsStopSearchButton"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="StopSearchButton"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.SearchStopsCommand}"
                                IsEnabled="{x:Bind ViewModel.IsServiceConfigured, Mode=OneTime}" />
                        </Grid>
                        <Button
                            x:Uid="SettingsLoadRoutesButton"
                            AutomationProperties.AutomationId="LoadRoutesButton"
                            HorizontalAlignment="Left"
                            Command="{x:Bind ViewModel.LoadRoutesCommand}"
                            IsEnabled="{x:Bind ViewModel.IsLoadRoutesEnabled, Mode=OneWay}" />
                        <ComboBox
                            x:Uid="SettingsRouteBox"
                            AutomationProperties.AutomationId="RouteBox"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{x:Bind ViewModel.IsRouteEnabled, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.Routes, Mode=OneWay}"
                            PlaceholderText="{x:Bind ViewModel.RoutePlaceholder, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedRoute, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="transit:TransitRoute" x:DefaultBindMode="OneTime">
                                    <TextBlock Text="{x:Bind local:AppStrings.RouteName(DisplayId, Name)}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox
                            x:Uid="SettingsDirectionBox"
                            AutomationProperties.AutomationId="DirectionBox"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{x:Bind ViewModel.IsDirectionEnabled, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.Directions, Mode=OneWay}"
                            PlaceholderText="{x:Bind ViewModel.DirectionPlaceholder, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedDirection, Mode=TwoWay}" />
                        <ComboBox
                            x:Uid="SettingsStopBox"
                            AutomationProperties.AutomationId="StopBox"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{x:Bind ViewModel.IsStopEnabled, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.Stops, Mode=OneWay}"
                            PlaceholderText="{x:Bind ViewModel.StopPlaceholder, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedStop, Mode=TwoWay}" />
                        <CheckBox
                            x:Uid="SettingsAllRoutesCheck"
                            AutomationProperties.AutomationId="AllRoutesCheck"
                            IsChecked="{x:Bind ViewModel.AllRoutes, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.IsAllRoutesEnabled, Mode=OneWay}">
                            <TextBlock x:Uid="SettingsAllRoutesLabel" TextWrapping="Wrap" />
                        </CheckBox>
                        <Button
                            x:Uid="SettingsAddStopButton"
                            AutomationProperties.AutomationId="AddStopButton"
                            HorizontalAlignment="Left"
                            Command="{x:Bind ViewModel.AddStopCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource SettingsDescriptionStyle}"
                            Text="{x:Bind ViewModel.AddStatus, Mode=OneWay}" />
                    </StackPanel>
                </Expander>

                <TextBlock x:Uid="SettingsAlertsHeading" Style="{StaticResource SettingsSectionStyle}" />
                <TextBlock
                    x:Uid="SettingsAlertsHelp"
                    Margin="0,0,0,4"
                    Style="{StaticResource SettingsDescriptionStyle}" />
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE823;" Style="{StaticResource SettingsIconStyle}" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="4">
                        <TextBlock
                            x:Name="HeadOutLabel"
                            x:Uid="SettingsHeadOutTitle"
                            Style="{StaticResource SettingsCardTitleStyle}" />
                        <TextBlock x:Uid="SettingsHeadOutDescription" Style="{StaticResource SettingsDescriptionStyle}" />
                    </StackPanel>
                    <NumberBox
                        x:Name="HeadOutBox"
                        x:Uid="SettingsHeadOutBox"
                        Grid.Column="2"
                        AutomationProperties.AutomationId="HeadOutBox"
                        AutomationProperties.LabeledBy="{x:Bind HeadOutLabel, Mode=OneTime}"
                        Width="124"
                        VerticalAlignment="Center"
                        Maximum="{x:Bind ViewModel.MaxHeadOutMinutes, Mode=OneTime}"
                        Minimum="{x:Bind ViewModel.MinHeadOutMinutes, Mode=OneTime}"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.HeadOutMinutes, Mode=TwoWay}" />
                </Grid>
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE708;" Style="{StaticResource SettingsIconStyle}" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="4">
                        <TextBlock
                            x:Name="KeepAwakeLabel"
                            x:Uid="SettingsKeepAwakeTitle"
                            Style="{StaticResource SettingsCardTitleStyle}" />
                        <TextBlock x:Uid="SettingsKeepAwakeDescription" Style="{StaticResource SettingsDescriptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="2"
                        AutomationProperties.AutomationId="KeepAwakeToggle"
                        AutomationProperties.LabeledBy="{x:Bind KeepAwakeLabel, Mode=OneTime}"
                        IsOn="{x:Bind ViewModel.KeepAwakeWhileTracking, Mode=TwoWay}"
                        MinWidth="0"
                        VerticalAlignment="Center" />
                </Grid>

                <TextBlock x:Uid="SettingsAppHeading" Style="{StaticResource SettingsSectionStyle}" />
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7F4;" Style="{StaticResource SettingsIconStyle}" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="4">
                        <TextBlock
                            x:Name="StartupLabel"
                            x:Uid="SettingsStartupTitle"
                            Style="{StaticResource SettingsCardTitleStyle}" />
                        <TextBlock x:Uid="SettingsStartupDescription" Style="{StaticResource SettingsDescriptionStyle}" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource SettingsDescriptionStyle}"
                            Text="{x:Bind ViewModel.StartupStatus, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasStartupStatus, Mode=OneWay}" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="2"
                        AutomationProperties.AutomationId="StartupToggle"
                        AutomationProperties.LabeledBy="{x:Bind StartupLabel, Mode=OneTime}"
                        IsEnabled="{x:Bind ViewModel.IsStartupToggleEnabled, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.RunAtStartup, Mode=TwoWay}"
                        MinWidth="0"
                        VerticalAlignment="Center" />
                </Grid>

                <Expander
                    x:Uid="SettingsApiUsageExpander"
                    AutomationProperties.AutomationId="ApiUsageExpander"
                    Style="{StaticResource SettingsExpanderStyle}">
                    <Expander.Header>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE9D9;" Style="{StaticResource SettingsIconStyle}" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Uid="SettingsApiUsageTitle" Style="{StaticResource SettingsCardTitleStyle}" />
                                <TextBlock x:Uid="SettingsApiUsageDescription" Style="{StaticResource SettingsDescriptionStyle}" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="12">
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Text="{x:Bind ViewModel.BudgetText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Text="{x:Bind ViewModel.EstimateText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock x:Uid="SettingsBudgetHelp" Style="{StaticResource SettingsDescriptionStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <NumberBox
                                x:Uid="SettingsCallsPerMinuteBox"
                                AutomationProperties.AutomationId="CallsPerMinuteBox"
                                Width="160"
                                Minimum="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.CallsPerMinute, Mode=TwoWay}" />
                            <NumberBox
                                x:Uid="SettingsCallsPerMonthBox"
                                AutomationProperties.AutomationId="CallsPerMonthBox"
                                Width="160"
                                Minimum="1"
                                SmallChange="100"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.CallsPerMonth, Mode=TwoWay}" />
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsEndpointHeading" Style="{StaticResource SettingsDescriptionStyle}" />
                            <TextBlock
                                x:Uid="SettingsTodayHeading"
                                Grid.Column="1"
                                HorizontalTextAlignment="End"
                                Style="{StaticResource SettingsDescriptionStyle}" />
                            <TextBlock
                                x:Uid="SettingsWeekHeading"
                                Grid.Column="2"
                                HorizontalTextAlignment="End"
                                Style="{StaticResource SettingsDescriptionStyle}" />
                            <TextBlock
                                x:Uid="SettingsMonthHeading"
                                Grid.Column="3"
                                HorizontalTextAlignment="End"
                                Style="{StaticResource SettingsDescriptionStyle}" />
                        </Grid>
                        <ItemsControl
                            x:Uid="SettingsApiUsageList"
                            IsTabStop="False"
                            ItemsSource="{x:Bind ViewModel.ApiUsage, Mode=OneTime}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ApiUsageRow" x:DefaultBindMode="OneTime">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalTextAlignment="End"
                                            Text="{x:Bind Today}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalTextAlignment="End"
                                            Text="{x:Bind Last7Days}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            HorizontalTextAlignment="End"
                                            Text="{x:Bind ThisMonth}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <Expander
                    x:Uid="SettingsAboutExpander"
                    AutomationProperties.AutomationId="AboutExpander"
                    Style="{StaticResource SettingsExpanderStyle}">
                    <Expander.Header>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE946;" Style="{StaticResource SettingsIconStyle}" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Uid="SettingsAboutTitle" Style="{StaticResource SettingsCardTitleStyle}" />
                                <TextBlock x:Uid="SettingsAboutDescription" Style="{StaticResource SettingsDescriptionStyle}" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="SettingsTransitCredits" Style="{StaticResource SettingsDescriptionStyle}" />
                        <TextBlock x:Uid="SettingsMapCredits" Style="{StaticResource SettingsDescriptionStyle}" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ex:WindowEx>
