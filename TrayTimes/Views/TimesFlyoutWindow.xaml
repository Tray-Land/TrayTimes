<?xml version="1.0" encoding="utf-8"?>
<ex:WindowEx
    x:Class="TrayTimes.Views.TimesFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ex="using:WinUIEx"
    xmlns:map="using:WinUIEx.Maps"
    xmlns:views="using:TrayTimes.Views"
    Title="Tray Times">

    <ex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </ex:WindowEx.SystemBackdrop>

    <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
            <KeyboardAccelerator Key="F5" Invoked="Refresh_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="230" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Storyboard x:Name="MapCoverFadeOut" Completed="MapCoverFadeOut_Completed">
                <DoubleAnimation
                    Storyboard.TargetName="MapCover"
                    Storyboard.TargetProperty="Opacity"
                    To="0"
                    Duration="0:0:0.3" />
            </Storyboard>

            <DataTemplate x:Key="ArrivalTemplate" x:DataType="views:ArrivalItem">
                <Grid ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        AutomationProperties.Name="{x:Bind AutomationName}"
                        Click="ArrivalButton_Click"
                        Opacity="{x:Bind RowOpacity}"
                        Style="{StaticResource RowButtonStyle}"
                        ToolTipService.ToolTip="Show this bus on the map">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                MinWidth="44"
                                Height="28"
                                Padding="6,0"
                                VerticalAlignment="Center"
                                Background="{x:Bind RouteBackground}"
                                CornerRadius="4">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{x:Bind RouteForeground}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind RouteLabel}" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind Destination}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind DetailText}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Opacity="{x:Bind EtaOpacity}"
                                Orientation="Horizontal"
                                Spacing="3">
                                <TextBlock
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="{x:Bind MinutesText}" />
                                <TextBlock
                                    Margin="0,0,0,3"
                                    VerticalAlignment="Bottom"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind UnitText}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <!--  Tracking mode: follow this bus and alert when it's time to head out  -->
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind TrackLabel}"
                        Click="TrackButton_Click"
                        ContextRequested="TrackButton_ContextRequested"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind TrackLabel}"
                        Visibility="{x:Bind TrackVisibility}">
                        <Grid>
                            <FontIcon
                                FontSize="16"
                                Glyph="{x:Bind TrackGlyph}"
                                Visibility="{x:Bind TrackOutlineVisibility}" />
                            <!--  Tracked: solid gold bell emoji  -->
                            <FontIcon
                                FontFamily="Segoe UI Emoji"
                                FontSize="16"
                                Glyph="&#x1F514;"
                                Visibility="{x:Bind TrackedBellVisibility}" />
                        </Grid>
                    </Button>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="StopGroupTemplate" x:DataType="views:StopGroupItem">
                <StackPanel Margin="0,0,0,8" Spacing="2">
                    <Grid ColumnSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Padding="8,4"
                            AutomationProperties.Name="{x:Bind AutomationName}"
                            Click="StopHeaderButton_Click"
                            Style="{StaticResource RowButtonStyle}"
                            ToolTipService.ToolTip="Show this stop on the map">
                            <StackPanel>
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Subtitle}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind SaveLabel}"
                            Click="SaveStopButton_Click"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind SaveLabel}"
                            Visibility="{x:Bind SaveVisibility}">
                            <FontIcon FontSize="16" Glyph="{x:Bind SaveGlyph}" />
                        </Button>
                    </Grid>
                    <ItemsControl ItemTemplate="{StaticResource ArrivalTemplate}" ItemsSource="{x:Bind Arrivals}" />
                    <TextBlock
                        Margin="8,0,8,4"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind EmptyText}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind EmptyVisibility}" />
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>

        <!--  Toolbar  -->
        <Grid Padding="14,6,6,6" ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Grid Width="8" Height="8">
                    <Ellipse x:Name="LiveDot" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                    <!--  Negative margin lets the ring circle the dot without shifting the text  -->
                    <ProgressRing
                        x:Name="LoadingRing"
                        Width="16"
                        Height="16"
                        MinWidth="16"
                        MinHeight="16"
                        Margin="-4"
                        AutomationProperties.Name="Loading arrival times"
                        IsActive="False"
                        IsIndeterminate="True" />
                </Grid>
                <StackPanel>
                    <TextBlock
                        x:Name="TitleText"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Arrivals" />
                    <TextBlock
                        x:Name="UpdatedText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </StackPanel>

            <Button
                Grid.Column="1"
                AutomationProperties.Name="Refresh arrival times"
                Click="RefreshButton_Click"
                Style="{StaticResource ToolbarButtonStyle}"
                ToolTipService.ToolTip="Refresh (F5)">
                <FontIcon FontSize="16" Glyph="&#xE72C;" />
            </Button>
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Show all listed stops on the map"
                Click="FitButton_Click"
                Style="{StaticResource ToolbarButtonStyle}"
                ToolTipService.ToolTip="Show all listed stops">
                <FontIcon FontSize="16" Glyph="&#xE80F;" />
            </Button>
            <Button
                Grid.Column="3"
                AutomationProperties.Name="Stops and settings"
                Click="SettingsButton_Click"
                Style="{StaticResource ToolbarButtonStyle}"
                ToolTipService.ToolTip="Stops and settings">
                <FontIcon FontSize="16" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <!--  What to list: favorite stops, buses to the likely next place, or stops near the device  -->
        <SelectorBar
            x:Name="ModeBar"
            Grid.Row="1"
            Margin="6,0"
            SelectionChanged="ModeBar_SelectionChanged">
            <SelectorBarItem Text="Favorites">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE734;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Commute">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE806;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Nearby">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE81D;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <!--  Map  -->
        <Grid Grid.Row="2">
            <map:MapControl
                x:Name="Map"
                AutomationProperties.Name="Map of your stops and approaching buses"
                MapStyle="Road" />
            <!--  Hides the map's light-gray clear color until the basemap's first tiles arrive  -->
            <Border
                x:Name="MapCover"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                IsHitTestVisible="False" />
            <!--  Shows what a tapped bus or stop pin is  -->
            <Border
                x:Name="MapCaption"
                Margin="8"
                Padding="10,4"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="6"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="MapCaptionText"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </Border>
        </Grid>

        <!--  Arrivals  -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Commute: where the rider is likely headed, with a way to pick somewhere else  -->
            <Grid
                x:Name="CommuteHeader"
                Padding="14,8,8,0"
                ColumnSpacing="10"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    x:Name="CommuteGlyph"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="20"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="CommuteTitle"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="CommuteSubtitle"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <DropDownButton
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Choose where you're going"
                    Content="Going to"
                    ToolTipService.ToolTip="Going somewhere else?">
                    <DropDownButton.Flyout>
                        <MenuFlyout
                            x:Name="DestinationMenu"
                            Opening="DestinationMenu_Opening"
                            Placement="BottomEdgeAlignedRight" />
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>

            <InfoBar
                x:Name="StatusBar"
                Grid.Row="1"
                Margin="8,8,8,0"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning" />

            <ScrollViewer Grid.Row="2" Padding="6,8,6,4">
                <ItemsControl x:Name="StopsList" ItemTemplate="{StaticResource StopGroupTemplate}" />
            </ScrollViewer>

            <StackPanel
                x:Name="EmptyState"
                Grid.Row="2"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="32"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE806;" />
                <TextBlock
                    x:Name="EmptyTitle"
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="EmptyText"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <ProgressRing
                    x:Name="EmptyRing"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Loading"
                    IsActive="False" />
                <Button
                    x:Name="EmptyButton"
                    HorizontalAlignment="Center"
                    Click="EmptyButton_Click"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</ex:WindowEx>
