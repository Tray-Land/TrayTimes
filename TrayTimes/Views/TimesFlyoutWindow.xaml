<?xml version="1.0" encoding="utf-8"?>
<ex:WindowEx
    x:Class="TrayTimes.Views.TimesFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrayTimes.Controls"
    xmlns:ex="using:WinUIEx"
    xmlns:map="using:WinUIEx.Maps"
    xmlns:views="using:TrayTimes.Views"
    Title="Tray Times">

    <ex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </ex:WindowEx.SystemBackdrop>

    <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
            <KeyboardAccelerator Key="Back" Invoked="Back_Invoked" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="Back_Invoked" />
            <KeyboardAccelerator Key="F5" Invoked="Refresh_Invoked" />
            <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="Fit_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="MapRow" Height="230" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Storyboard x:Name="MapCoverFadeOut" Completed="MapCoverFadeOut_Completed">
                <DoubleAnimation
                    Storyboard.TargetName="MapCover"
                    Storyboard.TargetProperty="Opacity"
                    To="0"
                    Duration="0:0:0.3" />
            </Storyboard>

            <!--  One bus in a route's strip of times: its minutes and clock time, with a bell to track it  -->
            <DataTemplate
                x:Key="BusTimeTemplate"
                x:DataType="views:BusTimeItem"
                x:DefaultBindMode="OneTime">
                <Button
                    MinHeight="30"
                    Padding="10,3"
                    AutomationProperties.AutomationId="{x:Bind Key}"
                    AutomationProperties.Name="{x:Bind TrackLabel}"
                    Click="TrackButton_Click"
                    ContextRequested="TrackButton_ContextRequested"
                    CornerRadius="15"
                    IsEnabled="{x:Bind CanTrack}"
                    Opacity="{x:Bind ChipOpacity}"
                    ToolTipService.ToolTip="{x:Bind TrackLabel}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Grid VerticalAlignment="Center" Loaded="Bell_Loaded">
                            <FontIcon
                                FontSize="12"
                                Glyph="&#xEA8F;"
                                Visibility="{x:Bind TrackOutlineVisibility}" />
                            <!--  Tracked: solid gold bell emoji  -->
                            <FontIcon
                                FontFamily="Segoe UI Emoji"
                                FontSize="12"
                                Glyph="&#x1F514;"
                                Visibility="{x:Bind TrackedBellVisibility}" />
                        </Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind MinutesText}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ClockText}" />
                    </StackPanel>
                </Button>
            </DataTemplate>

            <DataTemplate
                x:Key="ArrivalTemplate"
                x:DataType="views:ArrivalItem"
                x:DefaultBindMode="OneTime">
                <StackPanel Loaded="ArrivalRow_Loaded">
                    <Button
                        AutomationProperties.Name="{x:Bind AutomationName}"
                        Click="ArrivalButton_Click"
                        Opacity="{x:Bind RowOpacity}"
                        Style="{StaticResource RowButtonStyle}"
                        ToolTipService.ToolTip="Show this route's vehicles on the map">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                MinWidth="44"
                                Height="28"
                                Padding="6,0"
                                VerticalAlignment="Center"
                                Background="{x:Bind RouteBackground}"
                                CornerRadius="4">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{x:Bind RouteForeground}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind RouteLabel}" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind Destination}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <!--  When the bus comes | when it gets the rider where they're going  -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind DetailText}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="8,0"
                                        AutomationProperties.AccessibilityView="Raw"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="|"
                                        Visibility="{x:Bind TripEtaVisibility}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind TripEtaText}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind TripEtaVisibility}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Loaded="Eta_Loaded"
                                Opacity="{x:Bind EtaOpacity}"
                                Orientation="Horizontal"
                                Spacing="3">
                                <TextBlock
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="{x:Bind MinutesText}" />
                                <TextBlock
                                    Margin="0,0,0,3"
                                    VerticalAlignment="Bottom"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind UnitText}" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!--  This route's upcoming buses; each chip's bell tracks that bus and alerts when it's time to head out  -->
                    <ScrollViewer
                        Margin="64,0,8,2"
                        AutomationProperties.Name="{x:Bind TimesAutomationName}"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        Loaded="TimeStrip_Loaded"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled"
                        ViewChanged="TimeStrip_ViewChanged">
                        <!--  Bottom margin leaves room for the overlay scroll bar under the chips  -->
                        <ItemsControl
                            Margin="0,0,0,6"
                            ItemTemplate="{StaticResource BusTimeTemplate}"
                            ItemsSource="{x:Bind Times}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </DataTemplate>

            <DataTemplate
                x:Key="StopGroupTemplate"
                x:DataType="views:StopGroupItem"
                x:DefaultBindMode="OneTime">
                <StackPanel Margin="0,0,0,8" Spacing="2">
                    <Grid ColumnSpacing="2" Loaded="StopHeader_Loaded">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Padding="8,4"
                            AutomationProperties.Name="{x:Bind AutomationName}"
                            Click="StopHeaderButton_Click"
                            Style="{StaticResource RowButtonStyle}"
                            ToolTipService.ToolTip="Show this stop on the map">
                            <StackPanel>
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Subtitle}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind SaveLabel}"
                            Click="SaveStopButton_Click"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind SaveLabel}"
                            Visibility="{x:Bind SaveVisibility}">
                            <FontIcon
                                FontSize="16"
                                Glyph="{x:Bind SaveGlyph}"
                                Loaded="Star_Loaded" />
                        </Button>
                    </Grid>
                    <ItemsControl ItemTemplate="{StaticResource ArrivalTemplate}" ItemsSource="{x:Bind Arrivals}" />
                    <TextBlock
                        Margin="8,0,8,4"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind EmptyText}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind EmptyVisibility}" />
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>

        <!--  Toolbar  -->
        <Grid
            x:Name="Toolbar"
            Padding="14,6,6,6"
            ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid VerticalAlignment="Center" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="8" Height="8">
                    <Ellipse x:Name="LiveDot" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                    <!--  Negative margin lets the ring circle the dot without shifting the text  -->
                    <ProgressRing
                        x:Name="LoadingRing"
                        Width="16"
                        Height="16"
                        MinWidth="16"
                        MinHeight="16"
                        Margin="-4"
                        AutomationProperties.Name="Loading arrival times"
                        IsActive="False"
                        IsIndeterminate="True" />
                </Grid>
                <StackPanel Grid.Column="1">
                    <TextBlock
                        x:Name="TitleText"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Departures"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="UpdatedText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <Button
                x:Name="LocationPermissionButton"
                x:Uid="LocationPermissionButton"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="LocationPermissionButton"
                Style="{StaticResource ToolbarButtonStyle}"
                Visibility="Collapsed">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="16"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Glyph="&#xE7BA;" />
                <Button.Flyout>
                    <Flyout x:Name="LocationPermissionFlyout" Placement="BottomEdgeAlignedRight">
                        <StackPanel MaxWidth="260" Spacing="12">
                            <TextBlock
                                x:Uid="LocationPermissionHeading"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="LocationPermissionMessage"
                                x:Uid="LocationPermissionMessage"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="GrantLocationPermissionButton"
                                x:Uid="GrantLocationPermissionButton"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="GrantLocationPermissionButton"
                                Click="GrantLocationPermissionButton_Click" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!--  Keep the board's center beside Settings rather than in a second header row  -->
            <DropDownButton
                x:Name="PlaceChip"
                x:Uid="PlaceChip"
                Grid.Column="2"
                MaxWidth="170"
                Padding="8,4"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="PlaceChip">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        x:Name="PlaceChipGlyph"
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="14"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE81D;" />
                    <TextBlock
                        x:Name="PlaceChipText"
                        MaxWidth="108"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout
                        x:Name="PlaceMenu"
                        Opening="PlaceMenu_Opening"
                        Placement="BottomEdgeAlignedRight" />
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button
                Grid.Column="3"
                AutomationProperties.AutomationId="FlyoutSettingsButton"
                AutomationProperties.Name="Stops and settings"
                Click="SettingsButton_Click"
                Style="{StaticResource ToolbarButtonStyle}"
                ToolTipService.ToolTip="Stops and settings">
                <FontIcon
                    x:Name="SettingsIcon"
                    FontSize="16"
                    Glyph="&#xE713;" />
            </Button>
        </Grid>

        <!--  Map  -->
        <Grid Grid.Row="1">
            <map:MapControl
                x:Name="Map"
                AutomationProperties.AutomationId="FlyoutMap"
                AutomationProperties.Name="Map of your stops and the selected route's vehicles"
                MapStyle="Road"
                SizeChanged="Map_SizeChanged">
                <map:MapControl.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            x:Name="FitMenuItem"
                            x:Uid="BoardFitMenuItem"
                            AutomationProperties.AutomationId="FitMapMenuItem"
                            Click="FitMenuItem_Click" />
                        <MenuFlyoutItem
                            x:Uid="RefreshMapMenuItem"
                            AutomationProperties.AutomationId="RefreshMapMenuItem"
                            Click="RefreshMenuItem_Click" />
                    </MenuFlyout>
                </map:MapControl.ContextFlyout>
            </map:MapControl>
            <!--  Hides the map's light-gray clear color until the basemap's first tiles arrive  -->
            <Border
                x:Name="MapCover"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                IsHitTestVisible="False" />
            <!--  Shows what a tapped bus or stop pin is  -->
            <Border
                x:Name="MapCaption"
                Margin="8"
                Padding="10,4"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="6"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="MapCaptionText"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </Border>
        </Grid>

        <!--  Drag (or focus and press Up/Down) to trade map space for list space  -->
        <views:ResizeCursorGrid Grid.Row="2">
            <Thumb
                x:Name="Splitter"
                AutomationProperties.AutomationId="MapSplitter"
                AutomationProperties.Name="Resize the map"
                DoubleTapped="Splitter_DoubleTapped"
                DragCompleted="Splitter_DragCompleted"
                DragDelta="Splitter_DragDelta"
                IsTabStop="True"
                KeyDown="Splitter_KeyDown"
                ToolTipService.ToolTip="Drag to resize the map. Double-click to reset."
                UseSystemFocusVisuals="True">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <!--  A transparent band keeps the grab area bigger than the grip it shows  -->
                        <Grid Height="12" Background="Transparent">
                            <Rectangle
                                Width="36"
                                Height="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                RadiusX="2"
                                RadiusY="2" />
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </views:ResizeCursorGrid>

        <!--  Arrivals  -->
        <Grid x:Name="ArrivalsPane" Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  The trip to where the rider is likely headed, with a way to pick somewhere else  -->
            <controls:SuggestionCard x:Name="SuggestionCard" Visibility="Collapsed" />

            <InfoBar
                x:Name="StatusBar"
                Grid.Row="1"
                Margin="8,8,8,0"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning" />

            <ScrollViewer
                x:Name="ListScroller"
                Grid.Row="2"
                Padding="6,8,6,4">
                <ItemsControl x:Name="StopsList" ItemTemplate="{StaticResource StopGroupTemplate}" />
            </ScrollViewer>

            <StackPanel
                x:Name="EmptyState"
                Grid.Row="2"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="32"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE806;" />
                <TextBlock
                    x:Name="EmptyTitle"
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="EmptyStateText"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <ProgressRing
                    x:Name="EmptyRing"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Loading"
                    IsActive="False" />
                <Button
                    x:Name="EmptyButton"
                    HorizontalAlignment="Center"
                    Click="EmptyButton_Click"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <ContentControl
            x:Name="SearchHost"
            Grid.Row="3"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="Collapsed" />
        <ContentControl
            x:Name="TripHost"
            Grid.Row="3"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="Collapsed" />
        <!--  The active trip's progress (or its Resume card), shown on every open during a trip  -->
        <ContentControl
            x:Name="ProgressHost"
            Grid.Row="3"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="Collapsed" />

        <!--  Required by the Transit API terms: "Powered by Transit" stays visible in the main interface  -->
        <HyperlinkButton
            x:Name="PoweredByTransit"
            x:Uid="PoweredByTransit"
            Grid.Row="4"
            Margin="0,0,8,4"
            Padding="6,2"
            HorizontalAlignment="Right"
            AutomationProperties.AutomationId="PoweredByTransit"
            NavigateUri="https://transitapp.com">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Powered by" />
                <Image
                    Width="18"
                    Height="18"
                    AutomationProperties.AccessibilityView="Raw">
                    <Image.Source>
                        <SvgImageSource RasterizePixelWidth="72" RasterizePixelHeight="72" UriSource="ms-appx:///Assets/transit-icon-green.svg" />
                    </Image.Source>
                </Image>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Transit" />
            </StackPanel>
        </HyperlinkButton>
    </Grid>
</ex:WindowEx>
